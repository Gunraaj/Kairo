{
  "name": "kairo",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./.cf-dist",
    "not_found_handling": "single-page-application"
  },
  // Only the production workers.dev URL is served; per-version preview URLs stay off.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
